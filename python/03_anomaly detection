    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.ensemble import IsolationForest\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# Load clean data\n",
    "df = pd.read_csv('/Users/madhuramdhanesh/Downloads/loan_clean.csv')\n",
    "print(\"Data loaded:\", df.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "df7c15f8-56cd-44c7-b69c-553a9a7c65dd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total anomalies found: 7252\n",
      "Anomaly rate: 5.0 %\n"
     ]
    }
   ],
   "source": [
    "features = ['DebtRatio', 'MonthlyIncome',\n",
    "            'RevolvingUtilizationOfUnsecuredLines',\n",
    "            'age', 'risk_score', 'emi_burden']\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(df[features])\n",
    "\n",
    "iso_forest = IsolationForest(contamination=0.05, n_estimators=100, random_state=42)\n",
    "\n",
    "df['anomaly_flag'] = iso_forest.fit_predict(X_scaled)\n",
    "df['is_anomaly'] = df['anomaly_flag'].apply(lambda x: 1 if x == -1 else 0)\n",
    "\n",
    "print(\"Total anomalies found:\", df['is_anomaly'].sum())\n",
    "print(\"Anomaly rate:\", round(df['is_anomaly'].mean() * 100, 2), \"%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "52ae4eaf-4fba-4c80-b129-9eb3f0e01200",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Flagged by Isolation Forest: 7252\n",
      "Flagged by Z-score: 1292\n",
      "Flagged by BOTH methods: 924\n"
     ]
    }
   ],
   "source": [
    "from scipy import stats\n",
    "\n",
    "# Z-score method\n",
    "z_scores = np.abs(stats.zscore(df[features]))\n",
    "df['zscore_anomaly'] = (z_scores > 3).any(axis=1).astype(int)\n",
    "\n",
    "# How many flagged by BOTH methods\n",
    "both_flagged = df[(df['is_anomaly']==1) & (df['zscore_anomaly']==1)]\n",
    "print(\"Flagged by Isolation Forest:\", df['is_anomaly'].sum())\n",
    "print(\"Flagged by Z-score:\", df['zscore_anomaly'].sum())\n",
    "print(\"Flagged by BOTH methods:\", len(both_flagged))\n"
   ]
  },
