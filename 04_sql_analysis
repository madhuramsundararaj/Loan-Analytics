   "source": [
    "# Query 1 - Default rate by age group\n",
    "query1 = \"\"\"\n",
    "SELECT \n",
    "    age_group,\n",
    "    COUNT(*) AS total_loans,\n",
    "    SUM(SeriousDlqin2yrs) AS total_defaults,\n",
    "    ROUND(100.0 * SUM(SeriousDlqin2yrs) / COUNT(*), 2) AS default_rate_pct\n",
    "FROM loans\n",
    "GROUP BY age_group\n",
    "ORDER BY default_rate_pct DESC;\n",
    "\"\"\"\n",
    "\n",
    "result1 = pd.read_sql_query(query1, conn)\n",
    "print(\"Query 1 - Default Rate by Age Group\")\n",
    "print(result1)\n",
    "\n",
    "# Save to CSV\n",
    "result1.to_csv('/Users/madhuramdhanesh/Downloads/defaults_by_age.csv', index=False)\n",
    "print(\"Saved to defaults_by_age.csv\")"
   ]
