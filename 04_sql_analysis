    "import pandas as pd\n",
    "import sqlite3\n",
    "\n",
    "# Create SQLite database\n",
    "conn = sqlite3.connect('/Users/madhuramdhanesh/Downloads/loan_database.db')\n",
    "\n",
    "# Load clean data\n",
    "df = pd.read_csv('/Users/madhuramdhanesh/Downloads/loan_clean.csv')\n",
    "\n",
    "# Load into database\n",
    "df.to_sql('loans', conn, if_exists='replace', index=False)\n",
    "\n",
    "print(\"Data loaded successfully\")\n",
    "print(\"Total rows:\", len(df))"
   ]
  },
