    "# Query 2 - Default rate by debt ratio quartile\n",
    "query2 = \"\"\"\n",
    "SELECT \n",
    "    CASE \n",
    "        WHEN DebtRatio < 0.1 THEN 'Q1 - Low Debt'\n",
    "        WHEN DebtRatio < 0.3 THEN 'Q2 - Medium Debt'\n",
    "        WHEN DebtRatio < 0.6 THEN 'Q3 - High Debt'\n",
    "        ELSE 'Q4 - Very High Debt'\n",
    "    END AS debt_quartile,\n",
    "    COUNT(*) AS total_loans,\n",
    "    ROUND(AVG(SeriousDlqin2yrs) * 100, 2) AS default_rate_pct,\n",
    "    ROUND(AVG(MonthlyIncome), 0) AS avg_income\n",
    "FROM loans\n",
    "GROUP BY debt_quartile\n",
    "ORDER BY default_rate_pct DESC;\n",
    "\"\"\"\n",
    "\n",
    "result2 = pd.read_sql_query(query2, conn)\n",
    "print(\"Query 2 - Default Rate by Debt Quartile\")\n",
    "print(result2)\n",
    "\n",
    "result2.to_csv('/Users/madhuramdhanesh/Downloads/debt_quartile_analysis.csv', index=False)\n",
    "print(\"Saved to debt_quartile_analysis.csv\")"
   ]
